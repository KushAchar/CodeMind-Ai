# Copy to .env locally. Never commit real credentials.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://codemind:change-me@localhost:5432/codemind_db
QDRANT_URL=http://localhost:6333
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
